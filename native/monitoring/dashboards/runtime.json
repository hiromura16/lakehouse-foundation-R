{
  "uid": "lakehouse-r-runtime",
  "title": "Lakehouse R 稼働監視",
  "schemaVersion": 41,
  "editable": false,
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "tags": [
    "lakehouse-r",
    "operations"
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "サービスの状態",
      "description": "✓ 正常、× 異常。Composeネットワークからの疎通とプローブ結果の取得を確認します。",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "lakehouse-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_success or on(app) (0 * up{job=\"app-probes\"})",
          "legendFormat": "{{app}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "×",
                  "color": "red"
                },
                "1": {
                  "text": "✓",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "text": {
          "titleSize": 14,
          "valueSize": 28
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 2,
      "type": "state-timeline",
      "title": "ヘルスチェック履歴",
      "description": "緑は正常、赤は異常。区間にカーソルを合わせると状態を確認できます。HTTPは応答、TCPはポートへの到達を確認します。",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "lakehouse-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_success or on(app) (0 * up{job=\"app-probes\"})",
          "legendFormat": "{{app}}",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "異常",
                  "color": "red"
                },
                "1": {
                  "text": "正常",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "ヘルスチェック応答時間",
      "description": "監視先への接続にかかった時間を表示します。HTTPの場合は応答時間も含みます。",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "lakehouse-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_duration_seconds",
          "legendFormat": "{{app}}",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "取込・変換ジョブ",
      "description": "成功と失敗の累計を別々に表示します。ワーカーの再起動時に0へ戻ります。",
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "lakehouse-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "lakehouse_successful_runs",
          "legendFormat": "成功",
          "instant": false
        },
        {
          "refId": "B",
          "expr": "lakehouse_failed_runs",
          "legendFormat": "失敗",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "type": "stat",
      "title": "最終ジョブ成功からの経過時間",
      "description": "ワーカー起動後に成功したジョブがない間は値を表示しません。取得間隔のしきい値は設定していません。",
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "lakehouse-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(time() - lakehouse_last_success) and lakehouse_last_success > 0",
          "legendFormat": "最終成功",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "プロセス監視",
      "description": "✓ 取得成功、× 取得失敗。監視データの取得状況から監視側とアプリ側の障害を見分けます。",
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "lakehouse-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"native-metrics\"}",
          "legendFormat": "{{app}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "×",
                  "color": "red"
                },
                "1": {
                  "text": "✓",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "text": {
          "titleSize": 14,
          "valueSize": 28
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    }
  ]
}
