# このファイルは説明用で起動不可。全項目を非公開の 0600 ファイルに記入する。
# 管理registry: 承認済みの不変参照、または --oci-receipt と専用の検証済みローカルalias。
CDC_STAGE3_KAFKA_IMAGE=
CDC_STAGE3_CONNECT_IMAGE=
# 新規の専用KRaft UUID。他ランタイムのIDを流用しない。
CDC_STAGE3_CLUSTER_ID=
# 段階2で照合を終えた承認済み宛先。接続を自動発見しない。
CDC_STAGE3_SQL_HOST=
CDC_STAGE3_SQL_PORT=
CDC_STAGE3_SQL_DATABASE=
CDC_STAGE3_SQL_CERT_HOST=
# 空欄: Connect UID 1001所有・0600 の絶対パスを個別設定。
# properties のキー名は user / password / truststorePassword。値はここに置かない。
CDC_STAGE3_SQL_PROPERTIES_FILE=
CDC_STAGE3_TRUSTSTORE_FILE=
