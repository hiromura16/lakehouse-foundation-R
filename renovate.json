{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "enabledManagers": [
    "docker-compose",
    "dockerfile",
    "github-actions",
    "pip_requirements",
    "custom.regex"
  ],
  "automerge": false,
  "timezone": "Asia/Tokyo",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "customManagers": [
    {
      "customType": "regex",
      "description": "CIで使うRenovate本体のバージョンとダイジェストを一緒に更新する。",
      "managerFilePatterns": [
        ".github/workflows/renovate.yml"
      ],
      "matchStrings": [
        "RENOVATE_IMAGE: (?<depName>ghcr\\.io/renovatebot/renovate):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "タグとダイジェストを追跡し、コンテナ更新をレビュー可能にする。",
      "matchDatasources": [
        "docker"
      ],
      "pinDigests": true
    },
    {
      "description": "ハッシュ付きロックや生成元のPython依存は既存の手順で再生成する。",
      "matchManagers": [
        "pip_requirements"
      ],
      "enabled": false
    },
    {
      "description": "単独でインストールする合成SQLデータ用の依存を更新する。",
      "matchManagers": [
        "pip_requirements"
      ],
      "matchFileNames": [
        "requirements-demo.txt"
      ],
      "enabled": true
    },
    {
      "description": "CDC Stage 3のDockerfileと検証済みイメージ台帳は同時に人が更新する。",
      "matchManagers": [
        "dockerfile"
      ],
      "matchFileNames": [
        "infra/cdc-stage3/**"
      ],
      "enabled": false
    },
    {
      "description": "バックアップの世代別イメージ対応表と一緒に更新する。",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "quay.io/lakekeeper/catalog",
        "chrislusf/seaweedfs",
        "docker.io/chrislusf/seaweedfs"
      ],
      "enabled": false
    },
    {
      "description": "Pythonのマイナー版移行時は対象環境のwheelとロックを同時に検証する。",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "python",
        "library/python",
        "docker.io/library/python"
      ],
      "allowedVersions": "/^3\\.14(?:\\.\\d+)?-slim$/"
    }
  ]
}
