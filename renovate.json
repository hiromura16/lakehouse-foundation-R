{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "enabledManagers": [
    "docker-compose",
    "dockerfile",
    "github-actions",
    "pip_requirements",
    "custom.regex"
  ],
  "automerge": false,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "platformAutomerge": false,
  "ignoreTests": false,
  "internalChecksAsSuccess": false,
  "minimumReleaseAge": "3 days",
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "vulnerabilityAlerts": {
    "minimumReleaseAge": "3 days",
    "automerge": false
  },
  "timezone": "Asia/Tokyo",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "customManagers": [
    {
      "customType": "regex",
      "description": "CIで使うRenovate本体のバージョンとダイジェストを一緒に更新する。",
      "managerFilePatterns": [
        ".github/workflows/renovate.yml"
      ],
      "matchStrings": [
        "RENOVATE_IMAGE: (?<depName>ghcr\\.io/renovatebot/renovate):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "タグとダイジェストを追跡し、コンテナ更新をレビュー可能にする。",
      "matchDatasources": [
        "docker"
      ],
      "pinDigests": true
    },
    {
      "description": "ハッシュ付きロックや生成元のPython依存は既存の手順で再生成する。",
      "matchManagers": [
        "pip_requirements"
      ],
      "enabled": false
    },
    {
      "description": "単独でインストールする合成SQLデータ用の依存を更新する。",
      "matchManagers": [
        "pip_requirements"
      ],
      "matchFileNames": [
        "requirements-demo.txt"
      ],
      "enabled": true
    },
    {
      "description": "CDC Stage 3のDockerfileと検証済みイメージ台帳は同時に人が更新する。",
      "matchManagers": [
        "dockerfile"
      ],
      "matchFileNames": [
        "infra/cdc-stage3/**"
      ],
      "enabled": false
    },
    {
      "description": "バックアップの世代別イメージ対応表と一緒に更新する。",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "quay.io/lakekeeper/catalog",
        "chrislusf/seaweedfs",
        "docker.io/chrislusf/seaweedfs",
        "postgres",
        "library/postgres",
        "docker.io/library/postgres"
      ],
      "enabled": false
    },
    {
      "description": "Pythonのマイナー版移行時は対象環境のwheelとロックを同時に検証する。",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "python",
        "library/python",
        "docker.io/library/python"
      ],
      "allowedVersions": "/^3\\.14(?:\\.\\d+)?-slim$/"
    },
    {
      "description": "固定済み公式ActionはGitHub Releasesで公開日とSHAを確認し、パッチ更新とマイナー更新を分ける。",
      "matchManagers": [
        "github-actions"
      ],
      "matchDepTypes": [
        "action"
      ],
      "matchPackageNames": [
        "actions/checkout",
        "actions/setup-python"
      ],
      "separateMinorPatch": true,
      "matchCurrentValue": "/^v\\d+\\.\\d+\\.\\d+$/",
      "matchJsonata": [
        "$boolean(currentDigest)"
      ],
      "overrideDatasource": "github-releases"
    },
    {
      "description": "公開から3日が経過し、CIが通ったSHA固定済み公式Actionのパッチ更新を自動マージする。",
      "matchManagers": [
        "github-actions"
      ],
      "matchDepTypes": [
        "action"
      ],
      "matchPackageNames": [
        "actions/checkout",
        "actions/setup-python"
      ],
      "matchCurrentValue": "/^v\\d+\\.\\d+\\.\\d+$/",
      "matchJsonata": [
        "$boolean(currentDigest)"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": true
    },
    {
      "description": "uv本体は公式setup-uv Actionに同梱の版とチェックサムを使う。",
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "astral-sh/uv"
      ],
      "enabled": false
    }
  ]
}
